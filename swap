# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# Under the installer (--nested), output sits inside the installer's own
# step: no header or success line, steps become plain indented titles.
NESTED = False
_indent = "  "


def header(message: str) -> None:
    if NESTED:
        return
    bar = "─" * (len(message) + 4)
    print(f"  \033[36m╭{bar}╮\033[0m")
    print(f"  \033[36m│\033[0m  \033[1m{message}\033[0m  \033[36m│\033[0m")
    print(f"  \033[36m╰{bar}╯\033[0m", flush=True)


def section(message: str) -> None:
    if NESTED:
        print(f"    {message}", flush=True)
    else:
        print(f"\n  \033[1;36m▸\033[0m \033[1m{message}\033[0m", flush=True)


def log(message: str) -> None:
    print(f"{_indent}{message}", flush=True)


def log_warn(message: str) -> None:
    print(f"{_indent}\033[33m{message}\033[0m", flush=True)


def log_status(label: str, value: str) -> None:
    log(f"\033[2m{label:<14}\033[0m{value}")


def success(message: str) -> None:
    if not NESTED:
        print(f"\n  \033[1;32m✓ {message}\033[0m", flush=True)


@contextmanager
def step(title: str, done: str):
    """Run a step under a "▸ title" line, then print "✓ done" if it finished."""
    global _indent
    outer = _indent
    section(title)
    _indent = outer + "  " if NESTED else "    "
    try:
        yield
        if not NESTED:
            print(f"  \033[32m✓\033[0m {done}", flush=True)
    finally:
        _indent = outer


def read_fw_env(key: str) -> str | None:
    result = subprocess.run(
        ["fw_printenv", key],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        return None
    line = result.stdout.strip()
    prefix = f"{key}="
    if not line.startswith(prefix):
        return None
    return line[len(prefix):]


# ---------------------------------------------------------------------------
# Precondition checks
# ---------------------------------------------------------------------------

def require_root() -> None:
    if os.geteuid() != 0:
        raise SystemExit("run this as root on the K2")


def ignore_sighup() -> None:
    try:
        signal.signal(signal.SIGHUP, signal.SIG_IGN)
    except (AttributeError, OSError, ValueError):
        pass


def require_udisk() -> None:
    if not UDISK.is_dir():
        raise SystemExit(f"{UDISK} does not exist")
    if not os.path.ismount(UDISK):
        raise SystemExit(f"{UDISK} is not a mountpoint")
    probe = UDISK / ".swap-write-test"
    try:
        probe.write_text("ok\n", encoding="utf-8")
        probe.unlink()
    except OSError as exc:
        raise SystemExit(f"{UDISK} is not writable: {exc}") from exc


def service_control(action: str, targets: list[dict[str, list[str] | str]]) -> None:
    for target in targets:
        handled = False
        if shutil.which("systemctl"):
            for unit in target["systemd"]:
                result = subprocess.run(
                    ["systemctl", action, unit],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                )
                if result.returncode == 0:
                    handled = True
                    break

        for svc in target["init"]:
            init_script = Path("/etc/init.d") / svc
            if not init_script.exists():
                continue
            result = subprocess.run(
                [str(init_script), action],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
            if result.returncode == 0:
                handled = True
                break

        if handled:
            log(f"{'stopped' if action == 'stop' else action + 'ed'} {target['name']}")


def kill_process(name: str, *signal_args: str) -> None:
    result = subprocess.run(
        ["killall", *signal_args, name],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    if result.returncode == 0:
        log(f"killed {name}")


def kill_scripts(paths: list[str]) -> None:
    wanted = {path.encode() for path in paths}
    for pid in os.listdir("/proc"):
        if not pid.isdigit() or int(pid) == os.getpid():
            continue
        try:
            argv = Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0")
        except OSError:
            continue
        match = wanted.intersection(argv)
        if not match:
            continue
        try:
            os.kill(int(pid), signal.SIGKILL)
        except OSError:
            continue
        log(f"killed {os.path.basename(match.pop().decode())} (pid {pid})")


def quiet_udisk_writers() -> None:
    try:
        os.chdir("/")
    except OSError:
        pass

    for name in FIRST_KILL_PROCESSES:
        kill_process(name, "-9")
    kill_scripts(UDISK_WRITER_SCRIPTS)

    service_control("stop", SERVICE_TARGETS)

    for name in UDISK_WRITER_PROCESSES:
        kill_process(name)

    subprocess.run(["sync"], check=True)


# ---------------------------------------------------------------------------
# Environment detection
# ---------------------------------------------------------------------------

def detect_rootfs_env() -> str:
    """'custom' if /etc/.k2_custom exists, else 'stock'."""
    return "custom" if CUSTOM_ROOTFS_SENTINEL.exists() else "stock"


def detect_kernel_env() -> str:
    """'custom' if running kernel carries the -k2jt marker, else 'stock'."""
    return "custom" if CUSTOM_KERNEL_MARKER in os.uname().release else "stock"


def detect_running_env() -> str:
    """Return the running env only if kernel and rootfs agree; else abort."""
    rootfs_env = detect_rootfs_env()
    kernel_env = detect_kernel_env()
    if rootfs_env != kernel_env:
        raise SystemExit(
            f"DESYNC: kernel is '{kernel_env}' (uname={os.uname().release}) but "
            f"rootfs is '{rootfs_env}' (sentinel {CUSTOM_ROOTFS_SENTINEL}"
            f"{' present' if CUSTOM_ROOTFS_SENTINEL.exists() else ' absent'}).\n"
            f"  Refusing to swap. Restore a matching raw U-Boot env snapshot "
            f"for the boot/rootfs partition pair, then reboot."
        )
    return rootfs_env


def detect_active_slot() -> str:
    """Return 'A' or 'B' based on /proc/cmdline root=."""
    with open("/proc/cmdline") as f:
        cmdline = f.read()
    if "root=/dev/mmcblk0p6" in cmdline:
        return "A"
    if "root=/dev/mmcblk0p7" in cmdline:
        return "B"
    raise SystemExit("cannot determine active partition slot from /proc/cmdline")


def kernel_release_on_partition(partition_slot: str) -> str | None:
    """Read the kernel release from the gzip zImage on an inactive boot partition."""
    try:
        with open(PARTITION_PAIRS[partition_slot]["boot"], "rb") as f:
            hdr = f.read(2048)
            if len(hdr) < 40 or not hdr.startswith(ANDROID_BOOT_MAGIC):
                return None
            kernel_size = struct.unpack_from("<I", hdr, 8)[0]
            page_size = struct.unpack_from("<I", hdr, 36)[0]
            if not 0 < kernel_size <= MAX_KERNEL_SIZE:
                return None
            if page_size < 512 or page_size > 65536 or page_size & (page_size - 1):
                return None
            f.seek(page_size)
            kernel = f.read(kernel_size)
    except OSError:
        return None

    start = kernel.find(GZIP_MAGIC)
    while start >= 0:
        try:
            decomp = zlib.decompressobj(31)
            buf = b""
            for offset in range(start, len(kernel), 1 << 20):
                buf += decomp.decompress(kernel[offset:offset + (1 << 20)])
                idx = buf.find(LINUX_BANNER)
                if idx >= 0 and buf.find(b" ", idx + len(LINUX_BANNER)) >= 0:
                    rest = buf[idx + len(LINUX_BANNER):]
                    return rest.split(b" ", 1)[0].decode(errors="replace")
                buf = buf[-64:]
                if decomp.eof:
                    break
        except zlib.error:
            pass
        start = kernel.find(GZIP_MAGIC, start + 1)
    return None


def rootfs_has_sentinel(partition_slot: str) -> bool | None:
    """Mount an inactive rootfs read-only and check for the custom sentinel."""
    dev = PARTITION_PAIRS[partition_slot]["root"]
    try:
        with open(dev, "rb") as f:
            head = f.read(EXT_MAGIC_OFFSET + 2)
    except OSError:
        return None
    if head[:4] == SQUASHFS_MAGIC:
        fstype, opts = "squashfs", "ro"
    elif head[EXT_MAGIC_OFFSET:EXT_MAGIC_OFFSET + 2] == EXT_MAGIC:
        fstype, opts = "ext4", "ro,noload"
    else:
        return None

    mnt = tempfile.mkdtemp(prefix="swap-probe-")
    mounted = False
    try:
        mounted = subprocess.run(
            ["mount", "-t", fstype, "-o", opts, dev, mnt],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        ).returncode == 0
        if not mounted:
            return None
        return (Path(mnt) / CUSTOM_ROOTFS_SENTINEL.relative_to("/")).exists()
    finally:
        if os.path.ismount(mnt):
            umount = subprocess.run(["umount", mnt], capture_output=True, text=True)
            if umount.returncode != 0:
                raise SystemExit(
                    f"could not unmount probe of {dev} at {mnt}: "
                    f"{umount.stderr.strip() or umount.returncode}. Refusing to swap."
                )
        os.rmdir(mnt)


def require_target_installed(to_slot: str, from_partition_slot: str, to_partition_slot: str) -> None:
    """Refuse unless the target slot holds the firmware its env snapshot claims."""
    if to_slot == "custom":
        fix = f"Rerun the installer to reinstall {firmware_label(to_slot)}."
    else:
        fix = (
            f"Creality firmware is no longer intact on boot{to_partition_slot}/"
            f"rootfs{to_partition_slot}; restore it before swapping."
        )
    if to_partition_slot == from_partition_slot:
        raise SystemExit(
            f"slot '{to_slot}' points at rootfs{to_partition_slot}, which is the running slot. "
            f"A firmware update most likely overwrote it. {fix}"
        )

    release = kernel_release_on_partition(to_partition_slot)
    sentinel = rootfs_has_sentinel(to_partition_slot)
    if release is None or sentinel is None:
        raise SystemExit(
            f"could not read boot{to_partition_slot}/rootfs{to_partition_slot} markers "
            f"(kernel={release!r}, sentinel={sentinel!r}). {fix}"
        )

    kernel_env = "custom" if CUSTOM_KERNEL_MARKER in release else "stock"
    rootfs_env = "custom" if sentinel else "stock"
    if kernel_env != to_slot or rootfs_env != to_slot:
        raise SystemExit(
            f"boot{to_partition_slot} kernel is '{kernel_env}' ({release}) and "
            f"rootfs{to_partition_slot} is '{rootfs_env}', expected '{to_slot}'. {fix}"
        )


def firmware_label(env_name: str) -> str:
    if env_name == "stock":
        version = read_fw_env("version")
        return f"Creality firmware {version}" if version else "Creality firmware"
    return "Jacobean's firmware"


def confirm_swap(from_slot: str, from_partition_slot: str, to_slot: str, to_partition_slot: str) -> None:
    print()
    log_status("Running", f"{firmware_label(from_slot)} on slot {from_partition_slot}")
    log_status("Switching to", f"{firmware_label(to_slot)} on slot {to_partition_slot}")
    print()
    log("The printer reboots when the swap is done.")

    try:
        answer = input("\n  \033[36m›\033[0m Switch now? [y/N]: ").strip().lower()
    except EOFError:
        answer = ""

    if answer not in {"y", "yes"}:
        raise SystemExit("swap cancelled")


def reboot_device() -> None:
    section("Rebooting")
    subprocess.run(["sync"], check=True)
    subprocess.run(["reboot"], check=True)


# ---------------------------------------------------------------------------
# Raw U-Boot env snapshots
# ---------------------------------------------------------------------------

def env_crc(blob: bytes | bytearray) -> int:
    return binascii.crc32(blob[5:]) & 0xFFFFFFFF


def parse_env_blob(blob: bytes) -> dict:
    if len(blob) != ENV_SIZE:
        raise ValueError(f"env blob is {len(blob)} bytes, expected {ENV_SIZE}")
    stored_crc = struct.unpack("<I", blob[:4])[0]
    computed_crc = env_crc(blob)
    values = {}
    for raw in blob[5:].split(b"\0"):
        if not raw:
            break
        text = raw.decode(errors="replace")
        if "=" in text:
            key, value = text.split("=", 1)
            values[key] = value
    return {
        "stored_crc": f"{stored_crc:08x}",
        "computed_crc": f"{computed_crc:08x}",
        "valid_crc": stored_crc == computed_crc,
        "flag": blob[4],
        "values": values,
        "sha256": hashlib.sha256(blob).hexdigest(),
    }


def env_entries(blob: bytes) -> list[tuple[str, str]]:
    entries = []
    for raw in blob[5:].split(b"\0"):
        if not raw:
            break
        text = raw.decode(errors="replace")
        if "=" in text:
            key, value = text.split("=", 1)
            entries.append((key, value))
    return entries


def env_summary(device: str, info: dict) -> dict:
    values = info["values"]
    return {
        "device": device,
        "sha256": info["sha256"],
        "flag": info["flag"],
        "valid_crc": info["valid_crc"],
        "boot_partition": values.get("boot_partition"),
        "root_partition": values.get("root_partition"),
        "loglevel": values.get("loglevel"),
    }


def require_partition_slot(partition_slot: str, label: str) -> str:
    if partition_slot not in PARTITION_PAIRS:
        raise SystemExit(f"{label} has unknown partition slot '{partition_slot}'")
    return partition_slot


def env_validation_problems(info: dict, partition_slot: str) -> list[str]:
    partition_slot = require_partition_slot(partition_slot, "env validation")
    pair = PARTITION_PAIRS[partition_slot]
    values = info["values"]
    problems = []
    if not info["valid_crc"]:
        problems.append(
            f"CRC invalid stored={info['stored_crc']} computed={info['computed_crc']}"
        )
    if values.get("boot_partition") != pair["boot_env"]:
        problems.append(
            f"boot_partition={values.get('boot_partition')!r}, "
            f"expected {pair['boot_env']!r}"
        )
    if values.get("root_partition") != pair["root_env"]:
        problems.append(
            f"root_partition={values.get('root_partition')!r}, "
            f"expected {pair['root_env']!r}"
        )
    return problems


def validate_env_info(info: dict, partition_slot: str, label: str) -> None:
    problems = env_validation_problems(info, partition_slot)
    if problems:
        raise SystemExit(f"{label} env validation failed: " + "; ".join(problems))


def read_env_device(name: str) -> bytes:
    with ENV_DEVICES[name].open("rb") as f:
        blob = f.read(ENV_SIZE)
    if len(blob) != ENV_SIZE:
        raise SystemExit(f"short read from {ENV_DEVICES[name]}: {len(blob)} bytes")
    return blob


def write_env_device(name: str, blob: bytes) -> None:
    info = parse_env_blob(blob)
    if not info["valid_crc"]:
        raise SystemExit(f"refusing to write invalid env blob to {ENV_DEVICES[name]}")
    with ENV_DEVICES[name].open("r+b") as f:
        f.write(blob)
        f.flush()
        os.fsync(f.fileno())


def write_blob_file(path: Path, blob: bytes) -> None:
    with path.open("wb") as f:
        f.write(blob)
        f.flush()
        os.fsync(f.fileno())


def read_env_blobs() -> tuple[dict[str, bytes], dict[str, dict]]:
    blobs = {}
    infos = {}
    for name in ENV_DEVICES:
        blob = read_env_device(name)
        blobs[name] = blob
        infos[name] = parse_env_blob(blob)
    return blobs, infos


def select_current_env(infos: dict[str, dict], label: str) -> tuple[str, dict]:
    valid = {
        name: info
        for name, info in infos.items()
        if info["valid_crc"]
    }
    if not valid:
        raise SystemExit(f"{label} has no CRC-valid env sectors")
    if len(valid) == 1:
        name = next(iter(valid))
        return name, valid[name]

    p2 = valid["p2"]
    p3 = valid["p3"]
    if p2["flag"] == p3["flag"]:
        return "p2", p2  # U-Boot convention: p2 tiebreaker
    diff = (p2["flag"] - p3["flag"]) & 0xFF
    return ("p2", p2) if diff < 128 else ("p3", p3)


def inactive_env_device(current_device: str) -> str:
    if current_device == "p2":
        return "p3"
    if current_device == "p3":
        return "p2"
    raise SystemExit(f"unknown env device '{current_device}'")


def build_env_blob(source_blob: bytes, updates: dict[str, str], label: str) -> bytes:
    seen = set()
    rebuilt = bytearray()
    for key, value in env_entries(source_blob):
        if key in updates:
            value = updates[key]
        seen.add(key)
        rebuilt.extend(f"{key}={value}".encode())
        rebuilt.append(0)

    for key, value in updates.items():
        if key not in seen:
            rebuilt.extend(f"{key}={value}".encode())
            rebuilt.append(0)

    rebuilt.append(0)
    payload_size = ENV_SIZE - 5
    if len(rebuilt) > payload_size:
        raise SystemExit(f"{label} env does not fit in {ENV_SIZE:#x} bytes")

    data = bytearray(ENV_SIZE)
    data[4] = source_blob[4]
    data[5:5 + len(rebuilt)] = rebuilt
    data[:4] = struct.pack("<I", env_crc(data))
    return bytes(data)


def normalize_env_for_slot(source_blob: bytes, partition_slot: str, label: str) -> tuple[bytes, dict]:
    partition_slot = require_partition_slot(partition_slot, label)
    pair = PARTITION_PAIRS[partition_slot]
    source_info = parse_env_blob(source_blob)
    if not source_info["valid_crc"]:
        raise SystemExit(f"{label} source env has invalid CRC")
    for key in ("boot_partition", "root_partition"):
        if key not in source_info["values"]:
            raise SystemExit(f"{label} source env is missing {key}")

    normalized = build_env_blob(
        source_blob,
        {
            "boot_partition": pair["boot_env"],
            "root_partition": pair["root_env"],
        },
        label,
    )
    info = parse_env_blob(normalized)
    validate_env_info(info, partition_slot, f"{label} normalized env")
    return normalized, info


def next_env_flag(current_flag: int) -> int:
    return (current_flag + 1) & 0xFF


def set_env_flag(blob: bytes, flag: int) -> bytes:
    data = bytearray(blob)
    data[4] = flag & 0xFF
    data[:4] = struct.pack("<I", env_crc(data))
    return bytes(data)


def build_current_env_blob(
    source_blob: bytes,
    current_flag: int,
    partition_slot: str,
    label: str,
) -> tuple[bytes, dict]:
    updated, _normalized_info = normalize_env_for_slot(source_blob, partition_slot, label)
    updated = set_env_flag(updated, next_env_flag(current_flag))
    info = parse_env_blob(updated)
    validate_env_info(info, partition_slot, f"{label} generated env")
    return updated, info


def write_new_current_env(
    source_blob: bytes,
    partition_slot: str,
    label: str,
) -> tuple[str, dict]:
    _live_blobs, live_infos = read_env_blobs()
    current_device, current_info = select_current_env(live_infos, f"{label} live env")
    target_device = inactive_env_device(current_device)
    target_blob, target_info = build_current_env_blob(
        source_blob,
        current_info["flag"],
        partition_slot,
        label,
    )
    write_env_device(target_device, target_blob)
    subprocess.run(["sync"], check=True)
    return target_device, target_info


def verify_boot_env(partition_slot: str) -> None:
    _blobs, infos = read_env_blobs()
    _current_device, current_info = select_current_env(infos, "boot env verification")
    validate_env_info(current_info, partition_slot, "boot env verification")


