# Slot env helpers
# ---------------------------------------------------------------------------

def capture_env_to_slot(
    slot_dir: Path,
    env_type: str,
    partition_slot: str,
) -> tuple[str, dict]:
    slot_dir.mkdir(parents=True, exist_ok=True)
    partition_slot = require_partition_slot(partition_slot, f"{env_type} live env")
    blobs, infos = read_env_blobs()
    current_device, current_info = select_current_env(infos, f"{env_type} live env")
    normalized, normalized_info = normalize_env_for_slot(
        blobs[current_device],
        partition_slot,
        f"{env_type} {current_device}",
    )
    write_blob_file(slot_dir / ENV_SNAPSHOT_FILE, normalized)
    subprocess.run(["sync"], check=True)
    return current_device, normalized_info


def partition_slot_from_env(info: dict) -> str:
    bp = info["values"].get("boot_partition")
    rp = info["values"].get("root_partition")
    for slot, pair in PARTITION_PAIRS.items():
        if pair["boot_env"] == bp and pair["root_env"] == rp:
            return slot
    raise SystemExit(f"env has unrecognized partition pair {bp}/{rp}")


def load_slot_env(slot_dir: Path, slot_name: str) -> tuple[bytes, dict, str]:
    path = slot_dir / ENV_SNAPSHOT_FILE
    if not path.exists():
        raise SystemExit(f"slot '{slot_name}' is missing env snapshot {path.name}")
    blob = path.read_bytes()
    info = parse_env_blob(blob)
    partition_slot = partition_slot_from_env(info)
    validate_env_info(info, partition_slot, f"{slot_name} env")
    return blob, info, partition_slot


def restore_slot_env(slot_name: str) -> dict:
    slot_dir = SLOTS_DIR / slot_name
    blob, _info, partition_slot = load_slot_env(slot_dir, slot_name)
    target_device, target_info = write_new_current_env(
        blob,
        partition_slot,
        slot_name,
    )
    verify_boot_env(partition_slot)
    return env_summary(target_device, target_info)


# ---------------------------------------------------------------------------
# Live entry enumeration
# ---------------------------------------------------------------------------

def gather_live_entries() -> list[Path]:
    """Return top-level UDISK entries that are eligible to be moved."""
    return [
        entry for entry in sorted(UDISK.iterdir())
        if entry.name not in MANAGED_UDISK_NAMES
    ]


# ---------------------------------------------------------------------------
# Idempotent single-entry move helper
# ---------------------------------------------------------------------------

def move_entry_to_dir(src: Path, dest_dir: Path) -> None:
    """Move src into dest_dir. Skip if destination already exists (idempotent)."""
    dest = dest_dir / src.name
    if dest.exists() or dest.is_symlink():
        log_warn(f"skipping {src.name} — already at destination")
        return
    log(f"moving {src.name}")
    shutil.move(str(src), str(dest_dir))


def preflight_archive_moves(entries: list[Path], slot_dir: Path) -> None:
    slot_dir.mkdir(parents=True, exist_ok=True)
    problems = []
    for entry in entries:
        if entry.is_mount():
            problems.append(f"{entry.name} is a mountpoint")
    if problems:
        raise SystemExit("live archive preflight failed: " + "; ".join(problems))


# ---------------------------------------------------------------------------
# Archive / restore
# ---------------------------------------------------------------------------

def archive_live_to_slot(slot_name: str) -> None:
    slot_dir = SLOTS_DIR / slot_name
    partition_slot = detect_active_slot()
    entries = gather_live_entries()
    if not entries:
        log("nothing to archive (UDISK root is empty)")
    preflight_archive_moves(entries, slot_dir)
    for entry in entries:
        move_entry_to_dir(entry, slot_dir)
    # Capture env last as commit
    capture_env_to_slot(slot_dir, slot_name, partition_slot)


def restore_slot_to_live(slot_name: str) -> None:
    slot_dir = SLOTS_DIR / slot_name
    entries = [
        e for e in sorted(slot_dir.iterdir())
        if e.name not in PROTECTED_SLOT_FILES
    ]
    if not entries:
        log(f"slot '{slot_name}' is empty")
    for entry in entries:
        move_entry_to_dir(entry, UDISK)
    subprocess.run(["sync"], check=True)


