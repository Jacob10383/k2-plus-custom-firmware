)


def install_webcam() -> None:
    log("waiting for Moonraker...")
    if not wait_for_moonraker():
        log_warn("Moonraker webcam API did not come up in 120s — skipping webcam registration")
        return
    for webcam in WEBCAMS:
        if webcam["name"] == "Creality Nozzle":
            if not NOZZLE_CAMERA_ENV.exists():
                log("this OS image has no Creality nozzle camera stream; not adding it to the web UI")
                continue
            if not NOZZLE_CAMERA.exists():
                log("no Creality nozzle camera found; not adding it to the web UI")
                continue
        req = urllib.request.Request(
            "http://localhost:7125/server/webcams/item",
            data=json.dumps(webcam).encode(),
            headers={"Content-Type": "application/json"},
            method="POST",
        )
        with urllib.request.urlopen(req, timeout=10) as resp:
            result = json.load(resp)
        uid = result["result"]["webcam"]["uid"]
        log(f"registered webcam '{webcam['name']}' ({webcam['stream_url']}) uid={uid}")


def backup_config_dir() -> Path | None:
    """Move existing configs into config_backups/<timestamp> instead of deleting them."""
    if CONFIG_DIR.is_symlink() or (CONFIG_DIR.exists() and not CONFIG_DIR.is_dir()):
        log(f"removing non-directory {CONFIG_DIR}")
        CONFIG_DIR.unlink()
        return None
    if not CONFIG_DIR.is_dir():
        return None
    # never move config_backups into itself
    items = [path for path in CONFIG_DIR.iterdir() if path.name != "config_backups"]
    if not items:
        log("no existing configs to back up")
        return None
    stamp = time.strftime("bootstrap-replace-%Y%m%d-%H%M%S")
    dest = CONFIG_DIR / "config_backups" / stamp
    suffix = 1
    while dest.exists():
        suffix += 1
        dest = dest.with_name(f"{stamp}-{suffix}")
    dest.mkdir(parents=True)
    moved = []
    try:
        for item in items:
            shutil.move(str(item), dest / item.name)
            moved.append(item)
    except BaseException:
        # All or nothing: leave the live configs where they were.
        for item in reversed(moved):
            shutil.move(str(dest / item.name), item)
        shutil.rmtree(dest, ignore_errors=True)
        raise
    log(f"backed up {len(items)} item(s) -> {dest}")
    try:
        zip_old_config_backups(dest.parent, dest)
    except Exception as exc:
        log_warn(f"could not zip older config backups: {exc}")
    return dest


def raise_walk_error(exc: OSError) -> None:
    raise exc


def zip_config_backup(folder: Path) -> Path:
    archive = folder.with_name(f"{folder.name}.zip")
    partial = folder.with_name(f"{folder.name}.zip.partial")
    try:
        # The K2 has no RTC, so files written before NTP sync can predate 1980.
        with zipfile.ZipFile(
            partial, "w", zipfile.ZIP_DEFLATED, strict_timestamps=False
        ) as zf:
            # os.walk instead of rglob: rglob skips unreadable dirs, and the
            # folder is deleted once the zip is written.
            for dir_path, dir_names, file_names in os.walk(folder, onerror=raise_walk_error):
                dir_names.sort()
                here = Path(dir_path)
                zf.write(here, here.relative_to(folder.parent).as_posix())
                for entry in sorted(file_names) + [d for d in dir_names if (here / d).is_symlink()]:
                    path = here / entry
                    name = path.relative_to(folder.parent).as_posix()
                    st = path.lstat()
                    if stat.S_ISLNK(st.st_mode):
                        info = zipfile.ZipInfo(name, time.localtime(st.st_mtime)[:6])
                        info.create_system = 3
                        info.external_attr = 0o120777 << 16
                        zf.writestr(info, os.readlink(path))
                    elif stat.S_ISREG(st.st_mode):
                        zf.write(path, name)
                    else:
                        raise OSError(f"not a regular file: {name}")
        partial.replace(archive)
    finally:
        partial.unlink(missing_ok=True)
    shutil.rmtree(folder)
    return archive


def zip_old_config_backups(backups_dir: Path, current: Path) -> None:
    folders = sorted(
        path for path in backups_dir.glob("bootstrap-replace-*")
        if path.is_dir() and not path.is_symlink() and path != current
    )
    # The current snapshot always stays unzipped, even if a wrong clock sorts it first.
    older = folders[:max(0, len(folders) - (CONFIG_BACKUPS_KEPT_UNZIPPED - 1))]
    zipped = 0
    for folder in older:
        if folder.with_name(f"{folder.name}.zip").exists():
            log_warn(f"{folder.name}.zip already exists; leaving {folder.name} unzipped")
            continue
        try:
            zip_config_backup(folder)
        except Exception as exc:
            log_warn(f"could not zip {folder.name}: {exc}")
            continue
        zipped += 1
    if zipped:
        log(f"zipped {zipped} older config backup(s) in {backups_dir}")


DEVICE_TREE_COMPATIBLE = Path("/proc/device-tree/compatible")
SERIAL_BY_ID = Path("/dev/serial/by-id")
# OS images with this rule give a Cartographer a fixed /dev/cartographer.
CARTOGRAPHER_RULE = Path("/etc/udev/rules.d/99-cartographer.rules")
CARTOGRAPHER_LINK = "/dev/cartographer"
CARTOGRAPHER_SHIPPED_SERIAL = "/dev/ttyACM0"
# model: (label, device-tree compatible, config folder in the Kalico checkout)
K2_MODELS = {
    "k2-plus": ("K2 Plus", b"creality,k2plus", "k2"),
    "k2-pro": ("K2 Pro", b"creality,k2pro", "k2-pro"),
}


def detect_k2_model() -> str:
    """The board the kernel booted as. Kernels that predate K2 Pro support are Plus-only."""
    try:
        compatible = DEVICE_TREE_COMPATIBLE.read_bytes().split(b"\0")
    except OSError:
        compatible = []
    if K2_MODELS["k2-pro"][1] in compatible:
        return "k2-pro"
    if K2_MODELS["k2-plus"][1] not in compatible:
        log_warn(f"no K2 model in {DEVICE_TREE_COMPATIBLE}; using the K2 Plus configs (pass --model to choose)")
    return "k2-plus"


def k2_config_source(model: str | None) -> Path:
    if model is None:
        model = detect_k2_model()
    label, _compatible, folder = K2_MODELS[model]
    src = ROOT / "klipper" / "config" / folder
    if not src.is_dir():
        raise SystemExit(f"{label} configs not found at {src}; update Kalico first")
    printer_cfg = src / "printer.cfg"
    missing = [name for name in ("printer.cfg", *PROBE_CONFIG_FILES) if not (src / name).is_file()]
    if missing:
        raise SystemExit(f"{label} configs at {src} are incomplete (no {', '.join(missing)}); update Kalico first")
    if not _probe_stack_pattern().search(printer_cfg.read_text(encoding="utf-8")):
        raise SystemExit(f"{printer_cfg} has no {PROBE_STACK_BEGIN} / {PROBE_STACK_END} markers; update Kalico first")
    _headers, missing, _files = _walk_config(src)
    if missing:
        raise SystemExit(f"{label} configs at {src} include missing files ({', '.join(missing)}); update Kalico first")
    log(f"using the {label} configs from {src}")
    return src


def k2_config_names(src: Path) -> set[str]:
    """Every file name either model ships, so neither is restored as a user's extra file."""
    names = {path.name for path in src.iterdir()}
    for _label, _compatible, folder in K2_MODELS.values():
        tree = ROOT / "klipper" / "config" / folder
        if tree.is_dir():
            names.update(path.name for path in tree.iterdir())
    return names


def restore_config_backup(backup: Path) -> None:
    """Undo backup_config_dir(): clear what was installed and move the old configs back."""
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    for item in CONFIG_DIR.iterdir():
        if item.name == "config_backups":
            continue
        if item.is_dir() and not item.is_symlink():
            shutil.rmtree(item)
        else:
            item.unlink()
    for item in backup.iterdir():
        shutil.move(str(item), CONFIG_DIR / item.name)
    backup.rmdir()
    log_warn(f"put the old configs back from {backup}")


def install_k2_configs(src: Path) -> None:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    shutil.copytree(src, CONFIG_DIR, dirs_exist_ok=True)
    log(f"copied {src} -> {CONFIG_DIR}")


SAVE_CONFIG_MARKER = "#*# <---------------------- SAVE_CONFIG ---------------------->"


def split_save_config(text: str) -> tuple[str, str | None]:
    idx = text.find(SAVE_CONFIG_MARKER)
    if idx < 0:
        return text, None
    if idx > 0 and text[idx - 1] == "\n":
        idx -= 1
    return text[:idx], text[idx:]


SAVE_CONFIG_COMMENT_RE = re.compile("[#;].*$")
SAVE_CONFIG_OPTION_RE = re.compile("[^A-Za-z0-9_].*$")


SAVE_CONFIG_HEADER = (
    "\n#*# <---------------------- SAVE_CONFIG ---------------------->\n"
    "#*# DO NOT EDIT THIS BLOCK OR BELOW. The contents are auto-generated.\n"
    "#*#\n"
)


def save_config_options(blob: str) -> set[tuple[str, str]]:
    # Mirror Kalico's _find_autosave_data: a malformed block is ignored by
    # Kalico, so its options must not suppress any shipped defaults.
    blob = blob.replace("\r\n", "\n")
    pos = blob.find(SAVE_CONFIG_HEADER)
    if pos < 0:
        return set()
    body = blob[pos + len(SAVE_CONFIG_HEADER):].strip()
    for line in body.split("\n"):
        if body and (not line.startswith("#*#") or (len(line) >= 4 and not line.startswith("#*# "))):
            return set()
    options = set()
    section = None
    for line in body.split("\n"):
        if not line.startswith("#*#"):
            continue
        line = line[4:] if line.startswith("#*# ") else line[3:]
        if not line.strip() or line[0].isspace() or line[0] in "#;":
            continue  # blank, comment, or continuation of a multi-line value
        line = line.strip()
        if line.startswith("["):
            section = line[1:].split("]", 1)[0].strip()
        elif section is not None:
            options.add((section, SAVE_CONFIG_OPTION_RE.sub("", line).lower()))
    # Probe-mode switching regex-edits this line, so it must stay active.
    return {opt for opt in options if opt[1] != "register_as_probe"}


def comment_superseded_options(text: str, options: set[tuple[str, str]]) -> tuple[str, int]:
    # Same rule as Kalico's SAVE_CONFIG: comment out regular config lines (and
    # their continuation lines) for options that the SAVE_CONFIG block sets.
    lines = text.split("\n")
    section = None
    in_dup = False
    count = 0
    for i, line in enumerate(lines):
        pruned = SAVE_CONFIG_COMMENT_RE.sub("", line).rstrip()
        if not pruned:
            continue
        if pruned[0].isspace():
            if in_dup:
                lines[i] = "#" + line
            continue
        in_dup = False
        if pruned[0] == "[":
            section = pruned[1:-1].strip()
            continue
        if (section, SAVE_CONFIG_OPTION_RE.sub("", pruned).lower()) in options:
            in_dup = True
            lines[i] = "#" + line
            count += 1
    return "\n".join(lines), count


def install_moonraker_asvc() -> None:
    PRINTER_DATA.mkdir(parents=True, exist_ok=True)
    asvc = PRINTER_DATA / "moonraker.asvc"
    asvc.write_text(MOONRAKER_ASVC, encoding="utf-8")
    log(f"wrote {asvc}")


def install_timelapse() -> None:
    dest = ROOT / "moonraker" / "moonraker" / "components" / "timelapse.py"
    download(TIMELAPSE_URL, dest)
    log(f"wrote {dest}")


def verify_cartographer_package() -> None:
    python = ROOT / "klippy-env" / "bin" / "python"
    klipper_path = str(ROOT / "klipper")
    script = (
        "import sys, importlib; "
        f"sys.path.insert(0, {klipper_path!r}); "
        "from klippy import compat; "
        "compat.install(); "
        "importlib.import_module('klippy.extras.cartographer'); "
        "version = importlib.import_module('cartographer.__version__'); "
        "print(f\"cartographer {version.__version__} from {version.__file__}\")"
    )
    run([str(python), "-c", script])


PROBE_STACK_BEGIN = "# BEGIN_PROBE_STACK"
PROBE_STACK_END = "# END_PROBE_STACK"
PROBE_CONFIG_FILES = ("prtouch.cfg", "cartographer.cfg")
# mode: (label, active config -> register_as_probe)
PROBE_MODES = {
    "carto": (
        "carto (owns probe, prtouch not loaded)",
        {"cartographer.cfg": True},
    ),
    "mix": (
        "mix (carto owns probe, prtouch still loaded)",
        {"cartographer.cfg": True, "prtouch.cfg": False},
    ),
    "prtouch": (
        "prtouch (owns probe, carto not loaded)",
        {"prtouch.cfg": True},
    ),
}


def _probe_stack_block(mode: str) -> str:
    active = PROBE_MODES[mode][1]
    body = "".join(
        f"{'' if filename in active else '# '}[include {filename}]\n"
        for filename in PROBE_CONFIG_FILES
    )
    return f"{PROBE_STACK_BEGIN}\n{body}{PROBE_STACK_END}"


def _probe_stack_pattern() -> re.Pattern[str]:
    return re.compile(
        re.escape(PROBE_STACK_BEGIN) + r"(.*?)" + re.escape(PROBE_STACK_END),
        re.DOTALL,
    )


def _read_printer_cfg() -> tuple[Path, str]:
    printer_cfg = CONFIG_DIR / "printer.cfg"
    if not printer_cfg.is_file():
        raise SystemExit(f"missing config file: {printer_cfg}")
    text = printer_cfg.read_text(encoding="utf-8")
    if not _probe_stack_pattern().search(text):
        raise SystemExit(
            f"{printer_cfg} missing {PROBE_STACK_BEGIN} / {PROBE_STACK_END} markers"
        )
    return printer_cfg, text


def _config_headers(text: str) -> list[str]:
    """Section headers as Kalico reads them: each line cut at its first '#'
    (klippy/configfile.py _parse_config)."""
    headers = []
    for line in text.split("\n"):
        match = configparser.RawConfigParser.SECTCRE.match(line.split("#", 1)[0])
        if match:
            headers.append(match.group("header"))
    return headers


def _include_specs(text: str) -> list[str]:
    return [h[len("include "):].strip() for h in _config_headers(text) if h.startswith("include ")]


def _include_active(block: str, filename: str) -> bool:
    return filename in _include_specs(block)


def _walk_config(folder: Path) -> tuple[list[str], list[str], set[str]]:
    """Section headers in printer.cfg and everything it includes, include specs
    that name no file, and every file read, resolving includes the way Kalico does."""
    headers: list[str] = []
    missing: list[str] = []
    pending = [os.path.abspath(folder / "printer.cfg")]
    seen: set[str] = set()
    while pending:
        path = pending.pop()
        if path in seen:
            continue
        seen.add(path)
        try:
            text = Path(path).read_text(encoding="utf-8")
        except (OSError, UnicodeDecodeError):
            missing.append(path)
            continue
        headers += _config_headers(text)
        for spec in _include_specs(text):
            pattern = os.path.join(os.path.dirname(path), spec)
            found = sorted(glob.glob(pattern))
            if not found and not glob.has_magic(pattern):
                missing.append(spec)
            pending.extend(os.path.abspath(name) for name in found)
    return headers, missing, seen


def _get_rap(path: Path) -> bool | None:
    if not path.is_file():
        return None
    match = re.search(r"^register_as_probe\s*:\s*(\S+)", path.read_text(encoding="utf-8"), re.M)
    if match is None:
        return None
    value = match.group(1).lower()
    if value in ("1", "true", "yes", "on"):
        return True
    if value in ("0", "false", "no", "off"):
        return False
    return None


def _set_rap(path: Path, enabled: bool) -> None:
    if not path.is_file():
        raise SystemExit(f"missing config file: {path}")
    text = path.read_text(encoding="utf-8")
    new_text, n = re.subn(
        r"^register_as_probe\s*:.*$",
        f"register_as_probe: {'True' if enabled else 'False'}",
        text,
        count=1,
        flags=re.M,
    )
    if n != 1:
        raise SystemExit(f"register_as_probe not found in {path}")
    path.write_text(new_text, encoding="utf-8")


def _validate_probe_config(path: Path) -> None:
    if not path.is_file():
        raise SystemExit(f"missing config file: {path}")
    if not re.search(r"^register_as_probe\s*:.*$", path.read_text(encoding="utf-8"), re.M):
        raise SystemExit(f"register_as_probe not found in {path}")


def get_probe_mode() -> str | None:
    _printer_cfg, text = _read_printer_cfg()
    match = _probe_stack_pattern().search(text)
    assert match is not None  # validated by _read_printer_cfg
    block = match.group(1)
    active = {
        filename
        for filename in PROBE_CONFIG_FILES
        if _include_active(block, filename)
    }
    for mode, (_label, configs) in PROBE_MODES.items():
        if active == set(configs):
            return mode
    return None


def _probe_mode_rap_matches(mode: str) -> bool:
    return all(
        _get_rap(CONFIG_DIR / filename) is enabled
        for filename, enabled in PROBE_MODES[mode][1].items()
    )


def _rewrite_probe_stack(mode: str) -> None:
    printer_cfg, text = _read_printer_cfg()
    new_text, n = _probe_stack_pattern().subn(_probe_stack_block(mode), text, count=1)
    if n != 1:
        raise SystemExit(f"failed to rewrite probe stack markers in {printer_cfg}")
    printer_cfg.write_text(new_text, encoding="utf-8")


CARTO_MOUNT_NOTE = (
    "Cartographer mount: Y homes against the 5.8 mm Y-endstop spacer (cartographer.cfg). "
    "Fit the spacer, or Y is 5.8 mm off."
)
NO_SPACER_NOTE = (
    "Cartographer not loaded: Y homes without a Y-endstop spacer. Remove the spacer if one "
    "is fitted, or Y is 5.8 mm off and rear moves can hit the frame."
)


def y_spacer_note(mode: str) -> str:
    """What Y expects in this mode: set by the Cartographer mount config when it is loaded."""
    return CARTO_MOUNT_NOTE if "cartographer.cfg" in PROBE_MODES[mode][1] else NO_SPACER_NOTE


def report_probe_mode() -> None:
    if not CONFIG_DIR.is_dir():
        raise SystemExit(f"config dir not found: {CONFIG_DIR}")
    current = get_probe_mode()
    if current is None:
        raise SystemExit("could not determine probe mode from printer.cfg probe stack")
    success(f"Probe mode: {current} — {PROBE_MODES[current][0]}")
    log(y_spacer_note(current))
    if not _probe_mode_rap_matches(current):
        log_warn("register_as_probe flags do not match this stack; re-run with an explicit mode to fix")


def use_cartographer_link() -> bool:
    """Point cartographer.cfg at /dev/cartographer when this OS has the udev
    rule that creates it. Older images keep the shipped /dev/ttyACM0."""
    cfg = CONFIG_DIR / "cartographer.cfg"
    if not CARTOGRAPHER_RULE.is_file() or not cfg.is_file():
        return False
    lines = cfg.read_text(encoding="utf-8").splitlines(keepends=True)
    section = None
    for index, line in enumerate(lines):
        header = re.match(r"\[([^\]]+)\]", line)
        if header:
            section = header.group(1).strip()
            continue
        option = re.match(r"(serial\s*[:=]\s*)(\S+)(.*)", line, re.DOTALL)
        if section == "mcu cartographer" and option and option.group(2) == CARTOGRAPHER_SHIPPED_SERIAL:
            lines[index] = option.group(1) + CARTOGRAPHER_LINK + option.group(3)
            cfg.write_text("".join(lines), encoding="utf-8")
            log(f"cartographer.cfg: serial {CARTOGRAPHER_LINK}")
            return True
    return False


def set_probe_mode(mode: str, *, restart: bool = True, quiet: bool = False) -> bool:
    if mode not in PROBE_MODES:
        raise SystemExit(f"invalid probe mode {mode!r}; expected one of {tuple(PROBE_MODES)}")
    if not CONFIG_DIR.is_dir():
        raise SystemExit(f"config dir not found: {CONFIG_DIR}")
    use_cartographer_link()

    warning = y_spacer_note(mode)
    if mode == "prtouch":
        warning += "\n  Remove any Cartographer entries from printer.cfg's SAVE_CONFIG block before using PRTouch."
    if not quiet:
        log_warn(warning)
    label, configs = PROBE_MODES[mode]
    if get_probe_mode() == mode and _probe_mode_rap_matches(mode):
        if not quiet:
            success(f"Already set to {label}")
        return False

    config_updates = [
        (CONFIG_DIR / filename, enabled)
        for filename, enabled in configs.items()
    ]
    for path, _enabled in config_updates:
        _validate_probe_config(path)

    if not quiet:
        log(f"Switching to {label}")
    _rewrite_probe_stack(mode)
    for path, enabled in config_updates:
        _set_rap(path, enabled)

    if restart:
        with step("Restarting Klipper"):
            service_control("restart", ["klipper"])
    if not quiet:
        success(f"Switched to {label}")
    return True


def legacy_probe_mode(folder: Path) -> str | None:
    """The probe mode of a printer.cfg from before the probe-stack markers:
    which probe configs Kalico would load, through any include path."""
    _headers, _missing, files = _walk_config(folder)
    active = {
        filename for filename in PROBE_CONFIG_FILES
        if os.path.abspath(folder / filename) in files
    }
    for mode, (_label, configs) in PROBE_MODES.items():
        if active == set(configs):
            return mode
    return None


def cartographer_connected() -> bool:
    """A USB Cartographer, any model or firmware (usb-Cartographer_..., usb-cartographer_...)."""
    try:
        return any("cartographer" in path.name.lower() for path in SERIAL_BY_ID.iterdir())
    except OSError:
        return False


def choose_probe_mode() -> None:
    """Configs ship in prtouch mode; a connected Cartographer gets mix.
    carto alone is only ever set by hand (bootstrap --probe carto)."""
    if cartographer_connected():
        set_probe_mode("mix", restart=False, quiet=True)
        log(f"Cartographer found: probe mode {PROBE_MODES['mix'][0]} (bootstrap --probe changes it)")
        log_warn(y_spacer_note("mix"))
    else:
        set_probe_mode("prtouch", restart=False, quiet=True)
        log(f"no Cartographer found: probe mode {PROBE_MODES['prtouch'][0]}")
        log(y_spacer_note("prtouch"))


def _has_stepper_z1(folder: Path) -> bool:
    """A K2 Plus config has two Z motors; a K2 Pro config has one."""
    headers, _missing, _files = _walk_config(folder)
    return any(header.strip() == "stepper_z1" for header in headers)


def update_k2_configs(src: Path) -> None:
    if not CONFIG_DIR.is_dir():
        raise SystemExit(f"config dir not found: {CONFIG_DIR}")

    probe_mode = None
    detect_error = None
    try:
        probe_mode = get_probe_mode()
    except SystemExit as exc:
        detect_error = str(exc).replace(str(CONFIG_DIR / "printer.cfg"), "printer.cfg")
    if probe_mode is None and detect_error is not None:
        probe_mode = legacy_probe_mode(CONFIG_DIR)
        if probe_mode:
            log(f"no probe stack markers; keeping probe mode {probe_mode} from printer.cfg's includes")
    if probe_mode is None:
        if detect_error is None:
            detect_error = "printer.cfg probe stack is not carto, mix, or prtouch"
        log_warn(f"Could not detect current probe mode ({detect_error}); choosing it from the hardware")

    printer_cfg = CONFIG_DIR / "printer.cfg"
    blob = None
    if printer_cfg.is_file():
        _, blob = split_save_config(printer_cfg.read_text(encoding="utf-8"))

    # Read the old model where its relative includes still resolve.
    other_model = printer_cfg.is_file() and _has_stepper_z1(CONFIG_DIR) != _has_stepper_z1(src)

    service_control("stop", ["moonraker", "klipper"])
    backup = None
    try:
        backup = backup_config_dir()
        install_k2_configs(src)
        _carry_over_configs(src, backup, blob, probe_mode, other_model)
    except BaseException:
        # Any failure after the move: put the working configs back and restart.
        if backup is not None:
            restore_config_backup(backup)
        service_control("start", ["klipper", "moonraker"])
        raise
    service_control("start", ["klipper", "moonraker"])


def _carry_over_configs(
    src: Path, backup: Path | None, blob: str | None, probe_mode: str | None, other_model: bool
) -> None:
    """Bring a user's overrides, extra files, SAVE_CONFIG and probe mode into the new configs."""
    other_model = other_model and backup is not None
    if other_model:
        # Overrides and SAVE_CONFIG values tuned against the other model's
        # configs (travel limits, pins, Z) are not safe to carry over.
        blob = None
        log_warn(
            f"The old configs (kept in {backup}) were for the other K2 model, so its overrides.cfg "
            "and SAVE_CONFIG block were not carried over. Copy back only what fits this printer, "
            "then calibrate again: bed mesh, Z offset and PID."
        )

    if backup is not None:
        stock_names = k2_config_names(src)
        for item in backup.iterdir():
            if item.name == "overrides.cfg" and other_model:
                continue
            if item.name != "overrides.cfg" and item.name in stock_names:
                continue
            dest = CONFIG_DIR / item.name
            if dest.exists():
                if dest.is_dir() and not dest.is_symlink():
                    shutil.rmtree(dest)
                else:
                    dest.unlink()
            if item.is_dir() and not item.is_symlink():
                shutil.copytree(item, dest)
            else:
                shutil.copy2(item, dest)
            log(f"restored {item.name}")

    if blob:
        dest = CONFIG_DIR / "printer.cfg"
        body, _ = split_save_config(dest.read_text(encoding="utf-8"))
        dest.write_text(body.rstrip() + "\n" + blob.lstrip("\n"), encoding="utf-8")
        log("restored SAVE_CONFIG block")

        # Kalico lets active config values override SAVE_CONFIG, so comment out
        # shipped defaults the block supersedes (as a live SAVE_CONFIG would).
        saved = save_config_options(blob)
        for name in sorted(p.name for p in src.glob("*.cfg")):
            if name == "overrides.cfg":
                continue
            cfg = CONFIG_DIR / name
            if not cfg.is_file():
                continue
            text = cfg.read_text(encoding="utf-8")
            body, tail = split_save_config(text)
            body, count = comment_superseded_options(body, saved)
            if count:
                cfg.write_text(body + (tail or ""), encoding="utf-8")
                log(f"commented out {count} default option(s) in {name} superseded by SAVE_CONFIG")

    if probe_mode and not other_model:
        changed = set_probe_mode(probe_mode, restart=False, quiet=True)
        if changed:
            log(f"restored probe mode {PROBE_MODES[probe_mode][0]}")
    else:
        # A mode set up for the other model may need hardware this printer lacks.
        choose_probe_mode()


def main() -> None:
    parser = argparse.ArgumentParser(description="Bootstrap wiped K2 UDISK payload")
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument(
        "--replace",
        nargs="*",
        metavar="TARGET",
        choices=["klipper", "moonraker", "klippy-env", "klipper-env", "moonraker-env", "fluidd", "mainsail", "configs", "helixscreen"],
        help="delete and recreate managed directories if they already exist (optionally specify targets; configs are moved to config_backups instead of deleted)",
    )
    mode.add_argument(
        "--update",
        nargs="*",
        metavar="TARGET",
        choices=["bootstrap", "configs"],
        help="update bootstrap and/or k2 configs (configs keep SAVE_CONFIG, overrides.cfg, extra files, and probe mode); Kalico extras update with Klipper",
    )
    mode.add_argument(
        "--set-timezone",
        action="store_true",
        help="detect timezone from public IP and apply it via timedatectl, then exit",
    )
    mode.add_argument(
        "--add-webcam",
        action="store_true",
        help="register the webcams with Moonraker, then exit",
    )
    mode.add_argument(
        "--probe",
        nargs="?",
        const="",
        default=None,
        metavar="MODE",
        help="show current probe stack, or set it to carto|mix|prtouch and restart klipper if changed",
    )
    parser.add_argument(
        "--model",
        choices=sorted(K2_MODELS),
        help="which configs to install or update (default: the board this kernel booted as)",
    )
    args = parser.parse_args()

    def should_run(target: str) -> bool:
        if args.replace is None or len(args.replace) == 0:
            return True
        if target in ("klippy-env", "klipper-env"):
            return "klippy-env" in args.replace or "klipper-env" in args.replace
        return target in args.replace

    def should_replace(target: str) -> bool:
        return args.replace is not None and should_run(target)

    def is_full_run() -> bool:
        return args.replace is None or len(args.replace) == 0

    if args.set_timezone:
        require_root()
        header("K2 Timezone Setup")
        set_timezone_from_ip()
        return

    if args.add_webcam:
        header("K2 Webcam Registration")
        install_webcam()
        return

    if args.probe is not None:
        header("K2 Probe Mode")
        if args.probe == "":
            report_probe_mode()
        elif args.probe not in PROBE_MODES:
            raise SystemExit(
                f"invalid probe mode {args.probe!r}; expected one of {tuple(PROBE_MODES)}"
            )
        else:
            set_probe_mode(args.probe)
        return

    if args.update is not None:
        update_bootstrap = not args.update or "bootstrap" in args.update
        update_configs = "configs" in args.update
        bootstrap_changed = False

        header("K2 Update")
        if update_bootstrap:
            require_root()
            with step("Updating bootstrap"):
                bootstrap_changed = install_bootstrap_update()
            if bootstrap_changed and update_configs:
                log("Relaunching updated bootstrap...")
                os.execv(sys.argv[0], sys.argv)
                return

        if update_configs:
            require_root()
            with step("Updating configs"):
                update_k2_configs(k2_config_source(args.model))

        notes = []
        if update_bootstrap:
            notes.append("Bootstrap updated" if bootstrap_changed else "Bootstrap already current")
        if update_configs:
            notes.append("Configs updated")
        success("; ".join(notes))
        return

    preflight_bootstrap(replace=args.replace)
    header("K2 UDISK Bootstrap")
    replace_helix = args.replace is not None and "helixscreen" in args.replace
    only_replace_helix = set(args.replace or []) == {"helixscreen"}

    # Replacing configs in an existing Kalico checkout: refuse before anything
    # stops if that checkout has no configs for this printer.
    if should_replace("configs") and not should_replace("klipper") and (ROOT / "klipper" / "config").is_dir():
        k2_config_source(args.model)

    if not only_replace_helix:
        with step("Stopping services"):
            service_control("stop", SERVICES_TO_STOP)

    ROOT.mkdir(parents=True, exist_ok=True)

    if is_full_run():
        with step("Setting timezone"):
            set_timezone_from_ip()

    if should_run("klipper"):
        with step("Cloning Kalico (klipper)"):
            clone_repo(KALICO_REPO, ROOT / "klipper", branch=KALICO_BRANCH, replace=should_replace("klipper"))

    if should_run("moonraker"):
        with step("Cloning Moonraker"):
            cloned = clone_repo(MOONRAKER_REPO, ROOT / "moonraker", branch=None, replace=should_replace("moonraker"))
            if cloned:
                install_timelapse()

    if should_run("klippy-env"):
        with step("Creating klippy venv"):
            created = create_venv(ROOT / "klippy-env", replace=should_replace("klippy-env"), system_site=True)
            if created:
                pip_install_requirements(
                    ROOT / "klippy-env",
                    [ROOT / "klipper" / "scripts" / "klippy-requirements.txt"],
                    CARTOGRAPHER_PACKAGE,
                )

        with step("Verifying Cartographer install"):
            verify_cartographer_package()

    if should_run("moonraker-env"):
        with step("Creating moonraker venv"):
            created = create_venv(ROOT / "moonraker-env", replace=should_replace("moonraker-env"), system_site=True)
            if created:
                pip_install_requirements(
                    ROOT / "moonraker-env",
                    [
                        ROOT / "moonraker" / "scripts" / "moonraker-requirements.txt",
                        ROOT / "moonraker" / "scripts" / "moonraker-speedups.txt",
                    ],
                )

    if should_run("fluidd"):
        with step("Installing Fluidd"):
            install_web_ui(FLUIDD_REPO, FLUIDD_ASSET, ROOT / "fluidd", replace=should_replace("fluidd"))

    if should_run("mainsail"):
        with step("Installing Mainsail"):
            install_web_ui(MAINSAIL_REPO, MAINSAIL_ASSET, ROOT / "mainsail", replace=should_replace("mainsail"))

    if should_run("configs"):
        with step("Setting up configs"):
            if CONFIG_DIR.exists() and not should_replace("configs"):
                log("configs already exist; skipping setup")
            else:
                src = k2_config_source(args.model)
                had_configs = (CONFIG_DIR / "printer.cfg").is_file()
                backup = None
                try:
                    if should_replace("configs"):
                        backup = backup_config_dir()
                    install_moonraker_asvc()
                    install_k2_configs(src)
                    choose_probe_mode()
                except BaseException:
                    if backup is not None:
                        restore_config_backup(backup)
                    if had_configs:
                        # The printer had working configs: run it on them again.
                        service_control("start", SERVICES_TO_START)
                    raise

    if replace_helix:
        with step("Installing HelixScreen"):
            install_helixscreen()

    if not only_replace_helix:
        with step("Starting services"):
            service_control("start", SERVICES_TO_START)

    if replace_helix:
        with step("Restarting HelixScreen"):
            service_control("restart", ["helixscreen"])
            service_control("restart", ["helixscreen-update.path"])

    if is_full_run() or should_run("moonraker"):
        with step("Registering webcam"):
            install_webcam()

    success("Bootstrap complete")


if __name__ == "__main__":
    main()
